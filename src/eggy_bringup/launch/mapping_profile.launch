<launch>
  <!-- 轻量建图配置：保留底盘、雷达、里程计融合和 gmapping，关闭巡检视觉链路。 -->
  <include file="$(find eggy_bringup)/launch/eggy_system.launch">
    <arg name="profile" value="mapping" />
    <arg name="use_mapping" value="true" />
    <arg name="use_amcl" value="false" />
    <arg name="use_navigation" value="true" />
    <arg name="navigation_cmd_vel_topic" value="/cmd_vel/mapping_raw" />
    <arg name="use_auto_mapping" value="true" />
    <arg name="use_camera" value="false" />
    <arg name="use_meter_rknn" value="false" />
    <arg name="use_kimi_server" value="false" />
    <arg name="use_kimi_bridge" value="false" />
    <arg name="use_inspection_servo_route" value="false" />
    <arg name="use_voice_controller" value="false" />
  </include>
</launch>
