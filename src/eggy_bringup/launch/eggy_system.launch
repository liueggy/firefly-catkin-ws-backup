<launch>
  <!-- Unified Eggy system launch: the single entry point for base, sensors, nav adapter and web bridge. -->
  <arg name="port" default="/dev/eggy_base" />
  <arg name="baudrate" default="115200" />
  <arg name="with_description" default="true" />
  <arg name="use_lidar" default="true" />
  <arg name="use_external_imu" default="false" />
  <arg name="external_imu_port" default="/dev/ttyS4" />
  <arg name="external_imu_frame_id" default="imu_link" />
  <arg name="use_rosbridge" default="true" />
  <arg name="rosbridge_port" default="9090" />
  <arg name="use_robot_agent" default="false" />
  <arg name="use_simple_nav" default="false" />
  <arg name="use_navigation" default="true" />
  <arg name="use_qt5_adapter" default="true" />
  <arg name="profile" default="mapping" />
  <arg name="legacy_qt_visual_relays" default="false" />
  <arg name="legacy_qt_camera_relay" default="false" />
  <arg name="use_camera" default="true" />
  <arg name="camera_device" default="/dev/orbbec_rgb23" />
  <arg name="camera_fps" default="10" />
  <arg name="use_meter_rknn" default="true" />
  <arg name="meter_model_path" default="/root/meter/best_raw_head_int8_toolkit150.rknn" />
  <arg name="meter_image_topic" default="/camera/front/image_source/compressed" />
  <arg name="meter_overlay_topic" default="/camera/front/image/compressed" />
  <arg name="meter_result_topic" default="/meter/detection" />
  <arg name="meter_conf" default="0.50" />
  <arg name="meter_nms" default="0.45" />
  <arg name="meter_max_det" default="2" />
  <arg name="meter_frame_skip" default="1" />
  <arg name="use_kimi_server" default="true" />
  <arg name="use_kimi_bridge" default="true" />
  <arg name="kimi_api_base" default="http://127.0.0.1:8000" />
  <arg name="use_inspection_servo_route" default="true" />
  <arg name="mission_inspection_capable" default="true" />
  <arg name="inspection_dry_run" default="false" />
  <arg name="inspection_enable_kimi_after_search" default="true" />
  <arg name="inspection_move_base_timeout" default="120" />
  <arg name="inspection_search_timeout" default="24" />
  <arg name="inspection_search_min_score" default="0.55" />
  <arg name="inspection_search_stable_frames" default="10" />
  <arg name="inspection_search_angular_speed_deg" default="18" />
  <arg name="inspection_search_step_deg" default="90" />
  <arg name="inspection_search_step_pause_sec" default="1.0" />
  <arg name="inspection_search_settle_sec" default="0.5" />
  <arg name="use_command_center" default="true" />
  <arg name="use_network_status" default="true" />
  <arg name="use_shell_bridge" default="true" />
  <arg name="use_nav_mode_status" default="true" />
  <arg name="use_usart1" default="true" />
  <arg name="use_voice_controller" default="true" />
  <arg name="usart1_port" default="/dev/eggy_usart1" />
  <arg name="default_temperature" default="25.0" />
  <arg name="default_humidity" default="50.0" />
  <arg name="dht_publish_rate" default="1.0" />
  <arg name="use_cpp_odom_fuser" default="true" />

  <arg name="use_mapping" default="true" />
  <arg name="use_amcl" default="false" />
  <arg name="map_file" default="/root/catkin_ws/maps/navigation/latest.yaml" />
  <arg name="mapping_autosave" default="false" />

  <group if="$(arg with_description)">
    <include file="$(find eggy_robot_description)/launch/description.launch" />
  </group>

  <!-- STM32 base driver: base_driver.launch already remaps raw wheel odom to /wheel_odom and STM32 IMU to /stm32/imu/data_raw. -->
  <include file="$(find eggy_base_driver)/launch/base_driver.launch">
    <arg name="port" value="$(arg port)" />
    <arg name="baudrate" value="$(arg baudrate)" />
  </include>

  <group if="$(arg use_lidar)">
    <include file="$(find rplidar_ros)/launch/rplidar_a1.launch" />
  </group>

  <group if="$(arg use_external_imu)">
    <include file="$(find eggy_external_imu)/launch/external_imu.launch">
      <arg name="port" value="$(arg external_imu_port)" />
      <arg name="frame_id" value="$(arg external_imu_frame_id)" />
    </include>
  </group>

  <!-- odom fuser: C++高性能版（默认）或 Python 兼容版 -->
  <group if="$(arg use_cpp_odom_fuser)">
    <node pkg="eggy_bringup" type="eggy_odom_fuser_node" name="eggy_external_imu_odom_fuser" output="screen">
      <param name="wheel_odom_topic" value="/wheel_odom" />
      <param name="imu_topic" value="/stm32/imu/data_raw" />
      <param name="odom_frame_id" value="odom" />
      <param name="base_frame_id" value="base_link" />
      <param name="publish_tf" value="true" />
      <param name="rate" value="50.0" />
    </node>
  </group>
  <group unless="$(arg use_cpp_odom_fuser)">
    <node pkg="eggy_bringup" type="eggy_external_imu_odom_fuser.py" name="eggy_external_imu_odom_fuser" output="screen">
      <param name="wheel_odom_topic" value="/wheel_odom" />
      <param name="imu_topic" value="/stm32/imu/data_raw" />
      <param name="odom_frame_id" value="odom" />
      <param name="base_frame_id" value="base_link" />
      <param name="publish_tf" value="true" />
      <param name="rate" value="50.0" />
    </node>
  </group>

  <!-- Static map navigation localization: map_server + AMCL. Do not enable together with gmapping/use_mapping. -->
  <group if="$(arg use_amcl)">
    <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_file)" />
    <node name="amcl" pkg="amcl" type="amcl" output="screen">
      <param name="odom_frame_id" value="odom" />
      <param name="base_frame_id" value="base_link" />
      <param name="global_frame_id" value="map" />
      <param name="use_map_topic" value="true" />
      <param name="odom_model_type" value="omni" />
      <param name="min_particles" value="100" />
      <param name="max_particles" value="500" />
      <param name="update_min_d" value="0.10" />
      <param name="update_min_a" value="0.20" />
      <param name="laser_max_range" value="8.0" />
      <param name="laser_min_range" value="0.15" />
      <param name="laser_max_beams" value="60" />
      <param name="transform_tolerance" value="0.35" />
      <param name="initial_pose_x" value="0.0" />
      <param name="initial_pose_y" value="0.0" />
      <param name="initial_pose_a" value="0.0" />
    </node>
  </group>


  <!-- Navigation stack (move_base + TEB): full path planning, costmaps, footprint. -->
  <group if="$(arg use_navigation)">
    <group if="$(arg use_amcl)">
      <include file="$(find eggy_bringup)/launch/move_base_nav.launch" />
    </group>
    <group unless="$(arg use_amcl)">
      <include file="$(find eggy_bringup)/launch/move_base_only.launch" />
    </group>
  </group>

  <!-- Simple point-to-point navigator: used only when navigation stack is off. -->
  <group unless="$(arg use_navigation)">
    <group if="$(arg use_simple_nav)">
      <node pkg="eggy_bringup" type="eggy_simple_navigator.py" name="eggy_simple_navigator" output="screen" />
    </group>
  </group>

  <group if="$(arg use_qt5_adapter)">
    <node pkg="eggy_bringup" type="ros_qt5_gui_adapter.py" name="ros_qt5_gui_adapter" output="screen">
      <param name="legacy_visual_relays" value="$(arg legacy_qt_visual_relays)" />
    </node>
  </group>

  <!-- Base driver remains on /cmd_vel; all primary producers use leased inputs. -->
  <!-- Single authoritative base-velocity owner. All producers publish to typed inputs. -->
  <node pkg="eggy_bringup" type="cmd_vel_arbiter.py" name="eggy_cmd_vel_arbiter" output="screen" />

  <!-- DISABLED 2026-06-01 (Eggy): Qt 客户端经 rosbridge 未订阅 /eggy_nav/status，关闭省内存/CPU
  <node pkg="eggy_bringup" type="eggy_nav_monitor.py" name="eggy_nav_monitor" output="screen">
    <param name="rate" value="5.0" />
  </node>
  -->

  <group if="$(arg use_camera)">
    <node pkg="eggy_bringup" type="eggy_camera_node.py" name="eggy_camera" output="screen">
      <param name="device" value="$(arg camera_device)" />
      <param name="width" value="1280" />
      <param name="height" value="720" />
      <param name="fps" value="$(arg camera_fps)" />
      <param name="pixel_format" value="mjpg" />
      <param name="mjpeg_passthrough" value="true" />
      <param name="compressed_topic" value="/camera/front/image_source/compressed" />
    </node>
  </group>


  <group if="$(arg use_meter_rknn)">
    <node pkg="eggy_bringup" type="meter_rknn_detect_node" name="meter_rknn_detect_cpp" output="screen" respawn="true" respawn_delay="3.0">
      <param name="model_path" value="$(arg meter_model_path)" />
      <param name="image_topic" value="$(arg meter_image_topic)" />
      <param name="overlay_comp_topic" value="$(arg meter_overlay_topic)" />
      <param name="result_topic" value="$(arg meter_result_topic)" />
      <param name="conf" value="$(arg meter_conf)" />
      <param name="nms" value="$(arg meter_nms)" />
      <param name="max_det" value="$(arg meter_max_det)" />
      <param name="frame_skip" value="$(arg meter_frame_skip)" />
    </node>
  </group>
  <!-- Compatibility only: current Qt subscribes to the stable raw source directly. -->
  <group if="$(arg use_camera)">
    <group if="$(arg legacy_qt_camera_relay)">
      <group unless="$(arg use_meter_rknn)">
        <node pkg="topic_tools" type="relay" name="eggy_camera_raw_to_qt"
              args="/camera/front/image_source/compressed /camera/front/image/compressed" />
      </group>
    </group>
  </group>

  <group if="$(arg use_kimi_server)">
    <node pkg="eggy_bringup" type="kimi_inspection_server.py" name="kimi_inspection_server" output="screen" respawn="true" respawn_delay="3.0">
      <env name="KIMI_ENV_FILE" value="/root/.config/kimi_inspection.env" />
    </node>
  </group>

  <group if="$(arg use_kimi_bridge)">
    <node pkg="eggy_bringup" type="kimi_inspection_bridge.py" name="kimi_inspection_bridge" output="screen" respawn="true" respawn_delay="3.0">
      <param name="image_topic" value="/camera/front/image_source/compressed" />
      <param name="api_base" value="$(arg kimi_api_base)" />
      <param name="default_task" value="meter" />
      <param name="timeout" value="60.0" />
    </node>
  </group>

  <!-- Sole mission motion owner: /eggy/mission/request -> move_base, with optional inspection. -->
  <group if="$(arg use_inspection_servo_route)">
    <node pkg="eggy_bringup" type="inspection_servo_route_runner.py" name="inspection_servo_route_runner" output="screen" respawn="true" respawn_delay="3.0">
      <param name="dry_run" value="$(arg inspection_dry_run)" />
      <param name="default_frame" value="map" />
      <param name="base_frame" value="base_link" />
      <param name="move_base_timeout" value="$(arg inspection_move_base_timeout)" />
      <param name="inspection_capable" value="$(arg mission_inspection_capable)" />
      <param name="cmd_vel_topic" value="/cmd_vel/mission" />
      <param name="enable_kimi_after_search" value="$(arg inspection_enable_kimi_after_search)" />
      <param name="search_timeout" value="$(arg inspection_search_timeout)" />
      <param name="search_min_score" value="$(arg inspection_search_min_score)" />
      <param name="search_stable_frames" value="$(arg inspection_search_stable_frames)" />
      <param name="search_angular_speed_deg" value="$(arg inspection_search_angular_speed_deg)" />
      <param name="search_step_deg" value="$(arg inspection_search_step_deg)" />
      <param name="search_step_pause_sec" value="$(arg inspection_search_step_pause_sec)" />
      <param name="search_settle_sec" value="$(arg inspection_search_settle_sec)" />
      <param name="search_max_rotation_deg" value="360.0" />
    </node>
  </group>

  <!--
    gmapping and AMCL must never own map->odom at the same time.  Keep the
    legacy arguments for compatibility, but make the launch condition itself
    enforce the invariant instead of relying only on comments/status reporting.
  -->
  <group if="$(arg use_mapping)">
    <group unless="$(arg use_amcl)">
      <include file="$(find eggy_bringup)/launch/mapping_light.launch">
        <arg name="scan_topic" value="/scan" />
        <arg name="base_frame" value="base_link" />
        <arg name="odom_frame" value="odom" />
        <arg name="autosave" value="$(arg mapping_autosave)" />
      </include>
    </group>
  </group>

  <group if="$(arg use_nav_mode_status)">
    <node pkg="eggy_bringup" type="eggy_nav_mode_status.py" name="eggy_nav_mode_status" output="screen">
      <param name="rate" value="1.0" />
      <param name="profile" value="$(arg profile)" />
      <param name="use_mapping" value="$(arg use_mapping)" />
      <param name="use_amcl" value="$(arg use_amcl)" />
      <param name="use_navigation" value="$(arg use_navigation)" />
      <param name="map_file" value="$(arg map_file)" />
      <param name="status_topic" value="/eggy/nav_mode/status" />
    </node>
  </group>

  <group if="$(arg use_rosbridge)">
    <include file="$(find rosbridge_server)/launch/rosbridge_websocket.launch">
      <arg name="port" value="$(arg rosbridge_port)" />
    </include>
  </group>

  <group if="$(arg use_robot_agent)">
    <node pkg="eggy_bringup" type="eggy_robot_agent.py" name="eggy_robot_agent" output="screen" />
  </group>

  <!-- eggy_command_center: Qt 调试命令中心，提供模块状态/控制/参数配置反馈通道 -->
  <group if="$(arg use_command_center)">
    <node pkg="eggy_bringup" type="eggy_command_center.py" name="eggy_command_center" output="screen">
      <param name="status_rate" value="1.0" />
      <param name="allow_shell" value="false" />
    </node>
  </group>

  <group if="$(arg use_network_status)">
    <node pkg="eggy_bringup" type="eggy_network_status.py" name="eggy_network_status" output="screen">
      <param name="rate" value="0.5" />
    </node>
  </group>

  <group if="$(arg use_shell_bridge)">
    <node pkg="eggy_bringup" type="eggy_shell_bridge.py" name="eggy_shell_bridge" output="screen">
      <param name="timeout" value="30.0" />
      <param name="output_limit" value="262144" />
    </node>
  </group>

  <!-- eggy_usart1_node: STM32 USART1 数据接收 (DHT11 温湿度 + 语音模块转发) -->
  <group if="$(arg use_usart1)">
    <node pkg="eggy_bringup" type="eggy_usart1_node.py" name="eggy_usart1_node" output="screen">
      <param name="port" value="$(arg usart1_port)" />
      <param name="baudrate" value="115200" />
      <param name="default_temperature" value="$(arg default_temperature)" />
      <param name="default_humidity" value="$(arg default_humidity)" />
      <param name="dht_publish_rate" value="$(arg dht_publish_rate)" />
    </node>
  </group>

  <!-- eggy_voice_controller: 语音指令绑定小车控制 -->
  <group if="$(arg use_voice_controller)">
    <node pkg="eggy_bringup" type="eggy_voice_controller.py" name="eggy_voice_controller" output="screen">
      <param name="forward_speed" value="0.6" />
      <param name="backward_speed" value="0.5" />
      <param name="turn_speed" value="1.2" />
      <param name="rotate_speed" value="2.0" />
      <param name="forward_duration" value="3.0" />
      <param name="backward_duration" value="3.0" />
      <param name="turn_duration" value="3.0" />
      <param name="rotate_duration" value="3.0" />
    </node>
  </group>

  <!-- eggy_health_aggregator: 聚合健康监控 CPU/内存/温度/节点/电池/激光/里程计/急停/导航 -->
  <node pkg="eggy_bringup" type="eggy_health_aggregator.py" name="eggy_health_aggregator" output="screen">
    <param name="rate" value="1.0" />
  </node>
</launch>
