<launch>
  <!-- move_base for SLAM mode: TEB local planner + GUI topic bridge -->
  <arg name="controller_frequency" default="8.0" />
  <arg name="planner_frequency" default="0.5" />

  <node name="move_base" pkg="move_base" type="move_base" output="screen" respawn="false">
    <rosparam file="$(find eggy_bringup)/config/nav/costmap_common_params.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find eggy_bringup)/config/nav/costmap_common_params.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find eggy_bringup)/config/nav/global_costmap_explore_params.yaml" command="load" />
    <rosparam file="$(find eggy_bringup)/config/nav/local_costmap_params.yaml" command="load" />
    <rosparam file="$(find eggy_bringup)/config/nav/teb_local_planner_params.yaml" command="load" />

    <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS" />
    <param name="base_global_planner" value="navfn/NavfnROS" />
    <param name="controller_frequency" value="$(arg controller_frequency)" />
    <param name="planner_frequency" value="$(arg planner_frequency)" />
    <param name="planner_patience" value="8.0" />
    <param name="controller_patience" value="12.0" />
    <param name="conservative_reset_dist" value="1.0" />
    <param name="clearing_rotation_allowed" value="true" />
    <param name="oscillation_timeout" value="12.0" />
    <param name="oscillation_distance" value="0.3" />
    <param name="max_planning_retries" value="4" />

    <rosparam>
recovery_behavior_enabled: true
recovery_behaviors:
  - name: conservative_reset
    type: clear_costmap_recovery/ClearCostmapRecovery
  - name: rotate_recovery
    type: rotate_recovery/RotateRecovery
conservative_reset:
  reset_distance: 1.5
  layer_names: ["obstacle_layer"]
rotate_recovery:
  max_vel_theta: 0.6
  min_in_place_vel_theta: 0.25
  frequency: 10.0
    </rosparam>

    <remap from="cmd_vel" to="/cmd_vel" />
    <remap from="move_base_simple/goal" to="/nav_goal" />
  </node>

  <!-- GUI topic bridge: move_base → Qt5 app compatible topics -->
  <node pkg="topic_tools" type="relay" name="gui_global_path"
        args="/move_base/NavfnROS/plan /global_path" output="screen" />
  <node pkg="topic_tools" type="relay" name="gui_local_path"
        args="/move_base/TebLocalPlannerROS/local_plan /local_path" output="screen" />
  <node pkg="topic_tools" type="relay" name="gui_global_costmap"
        args="/move_base/global_costmap/costmap /global_costmap" output="screen" />
  <node pkg="topic_tools" type="relay" name="gui_local_costmap"
        args="/move_base/local_costmap/costmap /local_costmap" output="screen" />
  <node pkg="topic_tools" type="relay" name="legacy_move_base_simple_goal"
        args="/move_base_simple/goal /nav_goal" output="screen" />
  <node pkg="topic_tools" type="relay" name="simple_goal_from_nav_goal"
        args="/nav_goal /simple_goal" output="screen" />
</launch>
